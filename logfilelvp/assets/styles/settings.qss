#settings {
    margin: 0;
}


#lbl-settings-large {
    font-size: 36px;
    color: #c8c8c8;
    margin: 18px 5px;
}

#line-settings {
    color: #c8c8c8;
    margin: 0 15px 0 15px;
}

#lbl-settings-first {
    font-size: 1.5em;
    font-weight: bold;
    color: #c8c8c8;
    margin: 25px 5px 0 11px;
}

#input-directory {
    margin: 0 10px 0 15px;
}

#button-directory {
    font-size: 1.5em;
    font-weight: bold;
    color: #0f1113;
    background-color: #393E46;
    border: none;
    margin: 0 15px 0 0;
    padding: 5px 10px;
}